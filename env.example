# Copy to .env locally, or set these in Render's Environment settings.
# Never commit a real .env file.

# Required for /admin and the admin API routes. No fallback value exists —
# admin routes stay disabled until this is set. Do not change the value
# already configured on Render; this file only documents the name.
ADMIN_PASSWORD=

PORT=3000

# Not wired up yet (see lib/notify.js) — reserved names for reconnecting
# the existing external Telegram notification setup once confirmed.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

